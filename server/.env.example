# Copy to .env (or set as GitHub Actions secrets) and replace every placeholder.
PORT=8787
# REQUIRED for the admin API. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=change-me-to-a-long-random-token
# Public URL clients use. MUST be https in production.
PUBLIC_BASE_URL=https://dist.example.com
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
MAX_BODY_BYTES=2097152

# Used by scripts/publish.js (CI) to register a freshly built artifact.
DIST_URL=https://dist.example.com
